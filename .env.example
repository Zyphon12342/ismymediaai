# Copy to .env.local for `npm run dev`. Values below match the local Supabase
# started by `npm run db:start` (run `npx supabase status` to see yours).
# Never put staging or production keys in this file.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server-only. Local default key from the Supabase CLI.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
# TMDB API Read Access Token (v4). Optional locally; CI uses recorded responses.
TMDB_API_TOKEN=
