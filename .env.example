# Copy to .env.local for `npm run dev`. The publishable key below is the
# Supabase CLI's public default for the local stack started by `npm run db:start`.
# Never put staging or production keys in this file.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server-only. Leave empty unless you need it: run `npx supabase status` and
# copy the local "Secret" key (it only works against your local database).
# Never put a staging or production secret key here.
SUPABASE_SECRET_KEY=
# TMDB API Read Access Token (v4). Optional locally; CI uses recorded responses.
TMDB_API_TOKEN=
